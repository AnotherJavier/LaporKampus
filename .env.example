# ── Aplikasi ────────────────────────────────────────────────────────────────
APP_NAME=LaporKampus
APP_PORT=3000
APP_ENV=development
# api | worker | all
APP_ROLE=all
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:5173

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# DATABASE_URL (bila diisi) menang atas DB_* di bawah.
DATABASE_URL=
DB_HOST=localhost
# Port host; di dalam Docker aplikasi memakai 5432.
DB_PORT=5433
DB_USER=lapor
DB_PASSWORD=lapor
DB_NAME=lapor_kampus
DB_SSLMODE=disable
DB_MAX_CONNS=10

# ── MongoDB (thread tiket & CSAT) ───────────────────────────────────────────
MONGO_URI=mongodb://localhost:27018
MONGO_DATABASE=lapor_kampus
MONGO_MAX_POOL=20

# ── Redis / Asynq ───────────────────────────────────────────────────────────
REDIS_ADDR=localhost:6380
REDIS_PASSWORD=
REDIS_DB=0
WORKER_CONCURRENCY=5

# ── Outbox relay (worker) ───────────────────────────────────────────────────
RELAY_INTERVAL_MS=1000
RELAY_BATCH=100

# ── Mailer (simulasi) ───────────────────────────────────────────────────────
MAILER_DELAY_MS=1500
MAILER_FAIL_EVERY=0

# ── JWT ─────────────────────────────────────────────────────────────────────
# Wajib minimal 32 karakter. Buat dengan: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=lapor-kampus
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_HOURS=168

# ── Swagger (opsional) ──────────────────────────────────────────────────────
SWAGGER_ENABLED=false
